# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database Configuration (Supabase PostgreSQL)
DB_NAME=postgres
DB_USER=postgres.your_username
DB_PASSWORD=your-db-password
DB_HOST=aws-X-eu-west-X.pooler.supabase.com
DB_PORT=5432

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379/1

# AWS S3 / Supabase Storage Configuration
AWS_ACCESS_KEY_ID=your-s3-access-key
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
AWS_S3_ENDPOINT_URL=https://your_project.supabase.co/storage/v1/s3
AWS_S3_CUSTOM_DOMAIN=your_project.supabase.co/storage/v1/object/public/media

# Email Configuration
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD="your-app-password "
